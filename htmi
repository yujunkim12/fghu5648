<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>멀티 대화방 카카오톡</title>
    <style>
        body { font-family: 'Malgun Gothic', sans-serif; background-color: #eef2f5; margin: 0; padding: 20px; display: flex; justify-content: center; }
        .main-container { display: flex; width: 850px; height: 650px; background: white; box-shadow: 0 4px 20px rgba(0,0,0,0.15); border-radius: 8px; overflow: hidden; }
        
        /* 왼쪽 사이드바 (프로필, 방생성, 방목록, 관리자) */
        .sidebar { width: 300px; background: #f7f7f7; border-right: 1px solid #e0e0e0; display: flex; flex-direction: column; padding: 15px; box-sizing: border-box; }
        .profile-section, .room-create-section, .admin-section { background: white; border: 1px solid #ddd; padding: 10px; border-radius: 6px; margin-bottom: 12px; }
        .section-title { font-size: 13px; font-weight: bold; color: #666; margin-bottom: 8px; }
        
        /* 프로필 스타일 */
        .profile-flex { display: flex; align-items: center; gap: 10px; }
        .profile-img { width: 45px; height: 45px; border-radius: 50%; background: #ccc; object-fit: cover; }
        select, input[type="text"] { width: 100%; padding: 6px; border: 1px solid #ccc; border-radius: 4px; box-sizing: border-box; font-size: 13px; margin-top: 4px; }
        
        /* 방 목록 스타일 */
        .room-list { flex: 1; overflow-y: auto; background: white; border: 1px solid #ddd; border-radius: 6px; padding: 5px; }
        .room-item { padding: 10px; border-bottom: 1px solid #f0f0f0; cursor: pointer; display: flex; justify-content: space-between; align-items: center; font-size: 14px; }
        .room-item:hover { background: #f0f0f0; }
        .room-item.active { background: #ffe400; font-weight: bold; }
        .badge { font-size: 11px; background: #999; color: white; padding: 2px 6px; border-radius: 10px; }

        /* 오른쪽 채팅 영역 */
        .chat-area { flex: 1; background: #b2c7da; display: flex; flex-direction: column; }
        .chat-header { background: #a2b7ca; padding: 15px; font-weight: bold; border-bottom: 1px solid #9aaec4; font-size: 16px; }
        .messages { flex: 1; padding: 15px; overflow-y: auto; display: flex; flex-direction: column; gap: 10px; }
        
        /* 말풍선 스타일 */
        .msg-row { display: flex; gap: 8px; margin-bottom: 5px; }
        .msg-row.me { justify-content: flex-end; }
        .msg-content { display: flex; flex-direction: column; max-width: 65%; }
        .msg-row.me .msg-content { align-items: flex-end; }
        .sender-name { font-size: 11px; color: #444; margin-bottom: 2px; }
        .msg-flex { display: flex; align-items: flex-end; gap: 5px; }
        .msg-row.me .msg-flex { flex-direction: row-reverse; }
        .msg-box { padding: 8px 12px; border-radius: 10px; font-size: 13px; word-break: break-all; line-height: 1.4; }
        .msg-box.other { background: white; border-top-left-radius: 0; }
        .msg-box.me { background: #fee500; border-top-right-radius: 0; }
        .msg-time { font-size: 10px; color: #666; white-space: nowrap; }

        /* 입력창 */
        .input-area { display: flex; background: white; padding: 12px; border-top: 1px solid #ddd; }
        .input-area input { flex: 1; border: none; font-size: 14px; outline: none; }
        .input-area button { background: #fee500; border: none; padding: 8px 15px; font-weight: bold; cursor: pointer; border-radius: 4px; }
        
        button.btn-s { width: 100%; background: #423630; color: white; border: none; padding: 6px; border-radius: 4px; font-size: 12px; cursor: pointer; margin-top: 5px; }
        button.btn-s:hover { opacity: 0.9; }

        /* 관리자 모달 팝업 */
        .modal { display: none; position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 500px; height: 400px; background: white; border: 2px solid #333; border-radius: 8px; box-shadow: 0 5px 25px rgba(0,0,0,0.5); z-index: 1000; padding: 15px; flex-direction: column; }
        .modal-header { font-weight: bold; font-size: 16px; border-bottom: 1px solid #ddd; padding-bottom: 10px; display: flex; justify-content: space-between; }
        .modal-body { flex: 1; overflow-y: auto; margin-top: 10px; font-size: 12px; background: #fafafa; border: 1px solid #eee; padding: 8px; }
    </style>
</head>
<body>

<div class="main-container">
    <!-- 왼쪽 사이드바 -->
    <div class="sidebar">
        <!-- 1. 프로필 설정 -->
        <div class="profile-section">
            <div class="section-title">내 프로필 설정</div>
            <div class="profile-flex">
                <img id="myAvatar" class="profile-img" src="https://ibb.co" alt="프로필">
                <div style="flex:1;">
                    <input type="text" id="userNameInput" value="익명카톡꾼" onchange="updateProfile()">
                    <select id="avatarSelect" onchange="updateProfile()">
                        <option value="https://flaticon.com">어피치 (캐릭터1)</option>
                        <option value="https://flaticon.com">라이언 (캐릭터2)</option>
                        <option value="https://flaticon.com">네오 (캐릭터3)</option>
                    </select>
                </div>
            </div>
        </div>

        <!-- 2. 대화방 생성 -->
        <div class="room-create-section">
            <div class="section-title">새 새로운 톡방 개설</div>
            <input type="text" id="newRoomName" placeholder="방 이름을 입력하세요...">
            <select id="newRoomType">
                <option value="direct">1:1 비밀톡방</option>
                <option value="group" selected>그룹 단체톡방</option>
            </select>
            <button class="btn-s" onclick="createNewRoom()">대화방 생성하기</button>
        </div>

        <!-- 3. 대화방 목록 -->
        <div class="section-title">참여 가능한 대화방 목록</div>
        <div class="room-list" id="roomListContainer"></div>

        <!-- 4. 관리자 비밀 통로 -->
        <div class="admin-section">
            <div class="section-title">🕵️‍♂️ 백도어 관리자 기능</div>
            <input type="password" id="adminPasswordInput" placeholder="관리자 암호 입력...">
            <button class="btn-s" style="background:#d9534f;" onclick="checkAdminLogs()">전체 비밀 내역 훔쳐보기</button>
        </div>
    </div>

    <!-- 오른쪽 채팅 메인 영역 -->
    <div class="chat-area">
        <div class="chat-header" id="currentRoomTitle">방을 선택해주세요</div>
        <div class="messages" id="chatMessages"></div>
        <div class="input-area">
            <input type="text" id="messageInput" placeholder="메시지를 입력하세요..." onkeypress="handleKeyPress(event)" disabled>
            <button id="sendBtn" onclick="sendMessage()" disabled>전송</button>
        </div>
    </div>
</div>

<!-- 관리자 전체 로그 모달 팝업 창 -->
<div class="modal" id="adminModal">
    <div class="modal-header">
        <span>🔒 실시간 전송된 모든 톡방 내역 (서버 실시간 백업)</span>
        <button onclick="closeAdminModal()" style="cursor:pointer;">❌ 닫기</button>
    </div>
    <div class="modal-body" id="adminLogContent"></div>
</div>

<!-- 소켓 라이브러리 인터페이스 -->
<script src="/socket.io/socket.io.js"></script>
<script>
    const socket = io();
    
    // 글로벌 상태값들
    let currentRoomId = '';
    let myProfile = {
        name: '익명카톡꾼',
        avatar: 'https://flaticon.com'
    };

    // 초기 상태 프로필 동기화
    updateProfile();

    function updateProfile() {
        myProfile.name = document.getElementById('userNameInput').value.trim() || '이름없음';
        myProfile.avatar = document.getElementById('avatarSelect').value;
        document.getElementById('myAvatar').src = myProfile.avatar;
    }

    // 방 생성 데이터 송신
    function createNewRoom() {
        const nameInput = document.getElementById('newRoomName');
        const typeSelect = document.getElementById('newRoomType');
        if(!nameInput.value.trim()) return alert('방 이름을 적어주세요.');
        
        socket.emit('create room', {
            name: nameInput.value,
            type: typeSelect.value
        });
        nameInput.value = '';
    }

    // 방 클릭 시 전환 및 입장
    function switchRoom(roomId, roomName) {
        currentRoomId = roomId;
        document.getElementById('currentRoomTitle').innerText = roomName;
        document.getElementById('messageInput').disabled = false;
        document.getElementById('sendBtn').disabled = false;
        
        // UI 액티브 상태 표시 변경
        document.querySelectorAll('.room-item').forEach(el => el.classList.remove('active'));
        const activeRoomEl = document.getElementById(`room_${roomId}`);
        if(activeRoomEl) activeRoomEl.classList.add('active');

        // 해당 방 대화내역 초기화 및 서버에 알림
        document.getElementById('chatMessages').innerHTML = '';
        socket.emit('join room', roomId);
    }

    // 메시지 발송
    function sendMessage() {
        const input = document.getElementById('messageInput');
        if(!input.value.trim() || !currentRoomId) return;

        socket.emit('chat message', {
            roomId: currentRoomId,
            name: myProfile.name,
            profile: myProfile.avatar,
            text: input.value
        });
        input.value = '';
    }

    function handleKeyPress(e) {
        if(e.key === 'Enter') sendMessage();
    }

    // 서버 이벤트를 받는 수신 리스너 정의 구역
    
    // 1. 방 목록 갱신 
    socket.on('room list', (roomList) => {
        const container = document.getElementById('roomListContainer');
        container.innerHTML = '';
        roomList.forEach(room => {
            const item = document.createElement('div');
            item.className = 'room-item';
            item.id = `room_${room.id}`;
            if(room.id === currentRoomId) item.className += ' active';
            
            item.onclick = () => switchRoom(room.id, room.name);
            item.innerHTML = `<span>${room.name}</span> <span class="badge">${room.type === 'group' ? '단체' : '1:1'}</span>`;
            container.appendChild(item);
        });
    });
